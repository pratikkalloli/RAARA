AI_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_CHAT_MODEL=YOUR_AVAILABLE_GROQ_MODEL
GROQ_REQUEST_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=1200

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

JWT_SECRET_KEY=YOUR_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite:///./raara.db
CHROMA_PERSIST_DIR=./chroma_data

MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=../documents/raw
EMBEDDING_BATCH_SIZE=100
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE=0.35
CONVERSATION_HISTORY_MAX_MESSAGES=6
CONVERSATION_HISTORY_MAX_CHARS=6000
